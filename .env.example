# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Better Auth core ---
# Random 32+ char secret used to sign session/cookie material.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL the app is served from (used to build callback/magic-link URLs).
BETTER_AUTH_URL="http://localhost:3000"

# --- Landlord allowlist (CAP-7, AD-5) ---
# The single identity permitted to hold the landlord role. Email is required;
# phone is optional but if set, must be in E.164 format (e.g. +919876543210).
LANDLORD_ALLOWLIST_EMAIL="prasennavenkatesh@gmail.com"
LANDLORD_ALLOWLIST_PHONE=""

# --- Google OAuth (Better Auth social provider) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Resend (email adapter: magic link + tenant invitations) ---
RESEND_API_KEY=""
# The default below is Resend's shared sandbox address -- it can only
# deliver to the Resend account owner's own verified email, never to a real
# tenant. Verify a custom domain in Resend and set RESEND_FROM_EMAIL to an
# address on it before real magic links or tenant invitations will deliver.
RESEND_FROM_EMAIL="Resident Portal <onboarding@resend.dev>"

# --- MSG91 (SMS adapter: phone+OTP) ---
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
# MSG91 OTP template/widget id, if using their template-based OTP API.
MSG91_OTP_TEMPLATE_ID=""

# --- Tenant invitation links ---
# Base URL used to build the tenant activation link sent by email.
# The actual /invite/[token] page is built in Story 3.
APP_BASE_URL="http://localhost:3000"
